---
export interface ProjectLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  date: string;
  size: string;
  tags?: string[];
  links?: ProjectLink[];
}

const { title, date, size, tags = [], links = [] } = Astro.props;
---

<div class="project-detail">
  <div class="project-title">{title}</div>
  <div class="project-meta">{date} · {size}</div>
  <div class="project-body">
    <slot />
  </div>
  {
    tags.length > 0 && (
      <div class="tags">
        {tags.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    )
  }
  {
    links.length > 0 && (
      <div class="project-links">
        {links.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
      </div>
    )
  }
</div>
