---
interface Props {
  path: string;
}

const { path } = Astro.props;
const titleText = `iker@iker.sh: ${path}`;
---

<div class="title-bar">
  <div class="dots">
    <span class="dot red"></span>
    <span class="dot yellow"></span>
    <span class="dot green"></span>
  </div>
  <span class="title-text" data-title-text>{titleText}</span>
  <div class="dots dots-spacer" aria-hidden="true">
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="dot"></span>
  </div>
</div>
