---
import Terminal from "../layouts/Terminal.astro";
import AboutContent from "../components/AboutContent.astro";
import { getCollection } from "astro:content";

const projectSlugs = (await getCollection("projects")).map((p) => p.slug);
---

<Terminal title="iker.sh" active="about">
  <div class="output dim" data-motd style="margin-bottom: 20px;">
    welcome to iker.sh — type <span class="accent" data-repl-cmd="help"
      >help</span
    > to get started, or use the tabs above.
  </div>

  <!-- Rendered source for the `cat about.md` REPL command. -->
  <div data-about-content hidden>
    <AboutContent />
  </div>

  <div class="repl" data-repl data-projects={JSON.stringify(projectSlugs)}>
    <div class="repl-history" data-repl-history></div>
    <div class="prompt-line repl-input-line">
      <span class="prompt">
        <span class="user">iker</span>@<span class="host">iker.sh</span>:<span
          class="path">~</span
        ><span class="dollar"> $</span>
      </span>
      <input
        type="text"
        class="repl-input"
        data-repl-input
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="terminal input"
      />
    </div>
  </div>
</Terminal>
