---
import TitleBar from "../components/TitleBar.astro";
import TabBar from "../components/TabBar.astro";
import "../styles/terminal.scss";

interface Props {
  title?: string;
  path: string;
  active: "about" | "projects" | "reading";
  description?: string;
}

const {
  title = "iker.sh",
  path,
  active,
  description = "iker lissarrague's personal site — software engineer",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <TitleBar path={path} />
    <TabBar active={active} />

    <main class="pane-container" data-pane-container>
      <article class="pane" data-pane>
        <slot />
      </article>
    </main>

    <div class="skip-hint" data-skip-hint hidden>
      click or press any key to skip
    </div>

    <script>
      import "../scripts/terminal.ts";
    </script>
  </body>
</html>
