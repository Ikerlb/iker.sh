---
import Terminal from "../layouts/Terminal.astro";
import Prompt from "../components/Prompt.astro";
import { getCollection, getEntry } from "astro:content";

const about = await getEntry("about", "index");
if (!about) {
  throw new Error("missing about content entry");
}
const { data } = about;
const { Content } = await about.render();

const projectSlugs = (await getCollection("projects")).map((p) => p.slug);
---

<Terminal title="iker.sh" active="about">
  <div class="output dim" data-motd style="margin-bottom: 16px;">
    welcome to iker.sh<br />
    last login: Tue Apr 7 09:42:13 2026 from 192.168.1.1<br />
    type <span class="accent" data-repl-cmd="help">help</span> or use the tabs above
    to navigate.
  </div>

  <div data-intro>
    <Prompt path="~" command="cat about.md" />
    <div class="cat-output">
      <p><span class="highlight">{data.name}</span> — {data.role}</p>
      <Content />
      <p style="margin-top:12px;">
        <span class="dim">email:</span>
        <a href="mailto:iker@iker.sh">iker@iker.sh</a> &nbsp; <span class="dim"
          >github:</span
        >
        <a href="https://github.com/Ikerlb/">Ikerlb</a> &nbsp; <span class="dim"
          >linkedin:</span
        >
        <a href="https://www.linkedin.com/in/iker-lissarrague/"
          >iker-lissarrague</a
        >
      </p>
    </div>
  </div>

  <div class="repl" data-repl data-projects={JSON.stringify(projectSlugs)}>
    <div class="repl-history" data-repl-history></div>
    <div class="prompt-line repl-input-line">
      <span class="prompt">
        <span class="user">iker</span>@<span class="host">iker.sh</span>:<span
          class="path">~</span
        ><span class="dollar"> $</span>
      </span>
      <input
        type="text"
        class="repl-input"
        data-repl-input
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="terminal input"
      />
    </div>
  </div>
</Terminal>
