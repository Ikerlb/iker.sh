---
import Terminal from "../layouts/Terminal.astro";
import AboutContent from "../components/AboutContent.astro";
import { getCollection } from "astro:content";

const projectSlugs = (await getCollection("projects")).map((p) => p.slug);
---

<Terminal title="iker.sh" active="about">
  <!-- Rendered source for the `cat about.md` REPL command. -->
  <div data-about-content hidden>
    <AboutContent />
  </div>

  <div
    class="repl repl-first"
    data-repl
    data-projects={JSON.stringify(projectSlugs)}
    style="margin-top: 0;"
  >
    <div class="repl-history" data-repl-history>
      <div class="repl-output dim">
        Last login: Tue Apr 7 09:42:13 2026 from 192.168.1.1
      </div>
      <div class="repl-output dim">
        type <span class="accent" data-repl-cmd="help">help</span> for a list of commands,
        or <span class="accent" data-repl-cmd="cat about.md">cat about.md</span> to
        see who i am.
      </div>
    </div>
    <div class="prompt-line repl-input-line">
      <span class="prompt">
        <span class="user">iker</span>@<span class="host">iker.sh</span>:<span
          class="path">~</span
        ><span class="dollar"> $</span>
      </span>
      <input
        type="text"
        class="repl-input"
        data-repl-input
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="terminal input"
      />
    </div>
  </div>
</Terminal>
